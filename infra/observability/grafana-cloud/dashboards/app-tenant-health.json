{
  "uid": "app-tenant-health",
  "title": "app · Per-tenant health",
  "description": "Everything about one tenant: errors, failed jobs, outbound sends and AI. Enter the tenantId from the alert in the Tenant ID box.",
  "tags": [
    "app",
    "tenant"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production",
          "selected": true
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "tenant",
        "label": "Tenant ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "The public tenant id (tenantId on log lines, tenant on metrics). Ids only: never a name, phone or email."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "type": "tags",
          "tags": [
            "deploy",
            "$env"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Which tenants are hurting (all tenants)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Error lines by tenant (range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (tenantId) (count_over_time({service=\"app-backend\", env=\"$env\"} | json | level=~\"50|60|error|critical\" | tenantId!=\"\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Final job failures by tenant (range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (tenantId) (count_over_time({service=\"app-backend\", env=\"$env\"} |= \"job.failed\" | json | event=\"job.failed\" | final=\"true\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "row",
      "title": "Selected tenant",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors by context",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (context) (count_over_time({service=\"app-backend\", env=\"$env\"} |= \"$tenant\" | json | tenantId=\"$tenant\" | level=~\"50|60|error|critical\" [$__auto]))",
          "legendFormat": "{{context}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Final job failures by job",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (jobName) (count_over_time({service=\"app-backend\", env=\"$env\"} |= \"$tenant\" | json | tenantId=\"$tenant\" | event=\"job.failed\" | final=\"true\" [$__auto]))",
          "legendFormat": "{{jobName}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbound send errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (context) (count_over_time({service=\"app-backend\", env=\"$env\"} |= \"$tenant\" | json | tenantId=\"$tenant\" | level=~\"50|60|error|critical\" | context=~\"EmailService|SmsService|TwilioVerifyService|FcmService|PushService|WhatsAppSendHandler|WebhookDeliveryProcessor\" [$__auto]))",
          "legendFormat": "{{context}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "AI errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (context) (count_over_time({service=\"app-backend\", env=\"$env\"} |= \"$tenant\" | json | tenantId=\"$tenant\" | level=~\"50|60|error|critical\" | context=~\"AssistantAiService|AiTelemetryService|AiRouteResolver|GuardrailsService\" [$__auto]))",
          "legendFormat": "{{context}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "AI invocations by surface and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (surface, status) (increase(app_ai_invocation_total{job=\"app-backend\", env=\"$env\", tenant=\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{surface}} {{status}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Job failures (metric)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (job_name) (increase(app_job_failed_total{job=\"app-backend\", env=\"$env\", tenant=\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{job_name}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "AI spend (USD) by surface",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (surface) (increase(app_ai_invocation_cost_usd_total{job=\"app-backend\", env=\"$env\", tenant=\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{surface}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Warnings and errors for this tenant",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service=\"app-backend\", env=\"$env\"} |= \"$tenant\" | json | tenantId=\"$tenant\" | level=~\"40|50|60|warning|error|critical\"",
          "legendFormat": "",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
