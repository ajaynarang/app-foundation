{
  "name": "app-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "app-foundation — domain-free platform starter",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "// — Make it yours (rename the template)": "",
    "init-app": "node tools/init-app/init-app.mjs",
    "// — Turbo (all apps)": "",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:root": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore \"*.{md,json,yaml,yml}\" docs .claude .github tools scripts infra",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || true",
    "// — Gates (CI is manual-only: these run locally)": "",
    "lint:schema": "pnpm --filter @appshore/db lint:schema",
    "accounts:duplicates": "pnpm --filter @appshore/db accounts:duplicates",
    "accounts:enforce-unique-email": "pnpm --filter @appshore/db accounts:enforce-unique-email",
    "verify": "bash tools/verify/verify.sh",
    "verify:api": "bash tools/verify/api-qa.sh",
    "verify:scaffold": "node tools/init-app/check-variants.mjs",
    "check:ops": "bash tools/verify/check-ops.sh",
    "audit:rbac": "tsx tests/scripts/audit-rbac-gaps.ts --ci",
    "test:init-app": "node --test tools/init-app/*.test.mjs",
    "// — Repository guards (tools/guards; Node only, seconds)": "",
    "guards": "node tools/guards/skills-guard.mjs && node tools/guards/ci-triggers.mjs && node tools/guards/convention-gate.mjs",
    "guard:skills": "node tools/guards/skills-guard.mjs --target skills",
    "guard:docs": "node tools/guards/skills-guard.mjs --target docs",
    "guard:source": "node tools/guards/skills-guard.mjs --target source",
    "guard:ci": "node tools/guards/ci-triggers.mjs",
    "guard:conventions": "node tools/guards/convention-gate.mjs",
    "test:guards": "node --test tools/guards/*.test.mjs",
    "test:hooks": "node --test .claude/hooks/tests/*.test.mjs",
    "verify:arch": "turbo run build --filter=@app/backend^... --output-logs=errors-only && pnpm --filter @app/backend exec jest src/architecture && pnpm --filter @app/web exec jest src/shared/components/__tests__/single-component-set.test.ts src/shared/components/page-chrome/__tests__/theme-tokens.test.ts src/features/__tests__/ui-grammar-guard.test.ts",
    "// — Backend shortcuts": "",
    "backend:dev": "turbo run dev --filter=@app/backend",
    "backend:build": "turbo run build --filter=@app/backend",
    "backend:test": "turbo run test --filter=@app/backend",
    "backend:db:push": "pnpm --filter @appshore/db db:push",
    "backend:seed": "pnpm --filter @appshore/db db:seed",
    "backend:prisma:generate": "pnpm --filter @appshore/db prisma:generate",
    "backend:prisma:studio": "pnpm --filter @appshore/db prisma:studio",
    "// — Frontend shortcuts": "",
    "frontend:dev": "turbo run dev --filter=@app/web",
    "// — Mobile (Flutter companion app)": "",
    "mobile:dev": "cd apps/mobile && flutter run",
    "mobile:test": "cd apps/mobile && flutter analyze && flutter test",
    "// — Docker (PostgreSQL and Redis; optional Loki/Tempo/Grafana via --profile observability)": "",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "// — Staging-debug (a second Postgres :5495 and Redis :6395 for a staging copy; docker-compose.stg-debug.yml)": "",
    "stg-debug:up": "docker compose -f docker-compose.stg-debug.yml up -d",
    "stg-debug:down": "docker compose -f docker-compose.stg-debug.yml down",
    "stg-debug:reset": "docker compose -f docker-compose.stg-debug.yml down -v",
    "stg-debug:pull": "bash tools/db/pull-staging.sh",
    "stg-debug:backend": "DATABASE_URL='postgresql://postgres:postgres@localhost:5495/app?schema=public' REDIS_URL='redis://localhost:6395' pnpm --filter @app/backend dev",
    "// — Doppler (dev with secrets injection)": "",
    "doppler:backend": "cd apps/backend && doppler run -- pnpm run dev",
    "doppler:frontend": "cd apps/web && doppler run -- pnpm run dev",
    "// — Side-by-side dev (opens iTerm2 tabs with custom ports)": "",
    "dev:side": "./tools/dev/app-dev.sh ",
    "dev:side:stop": "./tools/dev/app-dev.sh --stop",
    "// — Inngest (Desk durable workflow engine — local dev)": "",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:8000/api/v1/inngest",
    "// — QA (tests/) — all config (API_BASE_URL, WEB_BASE_URL, DEV_AUTH_SECRET) from Doppler app-backend/dev.": "",
    "test:qa": "pnpm --filter @app/qa test",
    "test:qa:local": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa test",
    "test:smoke:local": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa test:smoke",
    "test:rbac:local": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa test:rbac",
    "test:api:local": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa test:api",
    "test:browser:local": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa test:browser",
    "qa:report": "pnpm --filter @app/qa report",
    "qa:list-tenants": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa list-tenants",
    "qa:enable-features": "doppler run --project app-backend --config dev -- pnpm --filter @app/qa qa:enable-features"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --ignore-path .prettierignore",
      "node tools/guards/convention-gate.mjs --files"
    ],
    "*.{js,jsx,json,md,yaml,yml}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@presidio-dev/hai-guardrails@1.12.0": "patches/@presidio-dev__hai-guardrails@1.12.0.patch"
    }
  }
}
