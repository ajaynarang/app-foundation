{
  "components": {
    "schemas": {
      "ApiErrorEnvelope": {
        "properties": {
          "code": {
            "description": "An ApiErrorCode, or a code one area adds — treat an unknown code by its HTTP status",
            "type": "string"
          },
          "debugDetail": {
            "description": "Development only",
            "type": "string"
          },
          "detail": {
            "description": "User-facing copy — safe to show",
            "type": "string"
          },
          "fieldErrors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Only on 400: field → message",
            "type": "object"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "statusCode": {
            "description": "The HTTP status, repeated",
            "type": "integer"
          },
          "timestamp": {
            "description": "ISO-8601",
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "detail",
          "timestamp",
          "path",
          "method"
        ],
        "type": "object"
      },
      "OAuthAuthorizationServerMetadata": {
        "description": "RFC 8414 authorization server metadata",
        "properties": {
          "authorization_endpoint": {
            "type": "string"
          },
          "code_challenge_methods_supported": {
            "description": "Always `S256`",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "grant_types_supported": {
            "description": "`authorization_code`, `refresh_token`",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "issuer": {
            "description": "The issuer of every access token",
            "type": "string"
          },
          "registration_endpoint": {
            "description": "Dynamic client registration (RFC 7591)",
            "type": "string"
          },
          "response_types_supported": {
            "description": "Always `code`",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "revocation_endpoint": {
            "type": "string"
          },
          "scopes_supported": {
            "description": "The scopes a client may ask for",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "token_endpoint": {
            "type": "string"
          },
          "token_endpoint_auth_methods_supported": {
            "description": "`client_secret_post`, `none`",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint"
        ],
        "type": "object"
      },
      "OAuthError": {
        "properties": {
          "error": {
            "description": "An RFC 6749 error code (invalid_request, invalid_grant, invalid_client, …)",
            "type": "string"
          },
          "error_description": {
            "description": "A sentence a developer can read",
            "type": "string"
          }
        },
        "required": [
          "error",
          "error_description"
        ],
        "type": "object"
      },
      "OAuthProtectedResourceMetadata": {
        "description": "RFC 9728 protected resource metadata",
        "properties": {
          "authorization_servers": {
            "description": "The issuer that grants tokens for it",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "resource": {
            "description": "The protected resource: this API",
            "type": "string"
          },
          "scopes_supported": {
            "description": "The scopes a client may ask for",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "resource",
          "authorization_servers"
        ],
        "type": "object"
      },
      "OAuthRevokeRequestDto": {
        "properties": {
          "token": {
            "type": "string"
          },
          "token_type_hint": {
            "enum": [
              "access_token",
              "refresh_token"
            ],
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "OAuthTokenIssued": {
        "properties": {
          "access_token": {
            "description": "The bearer token for the MCP endpoints",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds until the access token expires",
            "type": "integer"
          },
          "refresh_token": {
            "description": "Exchange it at the token endpoint (grant_type=refresh_token) for a new pair",
            "type": "string"
          },
          "scope": {
            "description": "The scopes granted, space-delimited",
            "type": "string"
          },
          "token_type": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "scope"
        ],
        "type": "object"
      },
      "OAuthTokenRequestDto": {
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "code_verifier": {
            "type": "string"
          },
          "grant_type": {
            "enum": [
              "authorization_code",
              "refresh_token"
            ],
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "grant_type"
        ],
        "type": "object"
      },
      "RegisterOAuthClientDto": {
        "properties": {
          "client_name": {
            "example": "Claude",
            "maxLength": 255,
            "type": "string"
          },
          "client_uri": {
            "example": "https://claude.ai",
            "type": "string"
          },
          "grant_types": {
            "default": [
              "authorization_code"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "redirect_uris": {
            "example": [
              "https://claude.ai/api/mcp/auth_callback"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "response_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "description": "Space-delimited scopes; omitted: the advertised default set",
            "type": "string"
          },
          "token_endpoint_auth_method": {
            "default": "none",
            "description": "`none` registers a public client; anything else a confidential one",
            "type": "string"
          }
        },
        "required": [
          "client_name",
          "redirect_uris"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api-key": {
        "bearerFormat": "API Key",
        "description": "A personal API key (sk_…)",
        "in": "header",
        "name": "Authorization",
        "scheme": "bearer",
        "type": "http"
      },
      "oauth": {
        "description": "OAuth 2.1: authorization code with PKCE (S256); dynamic client registration.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/api/v1/oauth/authorize",
            "scopes": {
              "comms:send": "Send a message to a single recipient",
              "comms:send:bulk": "Send bulk broadcasts to many recipients",
              "documents:read": "View documents and their metadata",
              "documents:write": "Upload and update documents",
              "integrations:read": "View connected integrations and sync state",
              "integrations:write": "Trigger integration syncs",
              "integrations:write:sensitive": "Connect or disconnect integrations (requires PIN approval)",
              "knowledge:read": "Search and read the knowledge base"
            },
            "tokenUrl": "/api/v1/oauth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "What an outside developer can call: the MCP server, the OAuth 2.1 endpoints, and any route a product opens to API keys.\n\n- **Auth:** a personal API key (`Authorization: Bearer sk_…`) or an OAuth 2.1 access token, as each operation says.\n- **Errors:** REST errors are the `ApiErrorEnvelope` with a machine `code`; OAuth endpoints answer RFC 6749 errors.\n- **Versioning:** additive changes ship in v1; a breaking change ships as v2 beside v1, which then carries `Deprecation` and `Sunset` headers for at least six months.",
    "title": "App public API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
