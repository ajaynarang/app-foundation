            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizationServerMetadata"
                }
              }
            },
            "description": "The discovery document"
          }
        },
        "summary": "OAuth 2.1 authorization server metadata (RFC 8414)",
        "tags": [
          "OAuth"
        ]
      }
    },
    "/.well-known/oauth-protected-resource": {
      "get": {
