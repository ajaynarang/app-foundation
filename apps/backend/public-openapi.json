                }
              }
            },
            "description": "An OAuth error (RFC 6749 section 5.2): `error` says what happened"
          }
        },
        "summary": "OAuth 2.1 token revocation",
        "tags": [
          "OAuth"
        ]
      }
    },
    "/api/v1/oauth/token": {
      "post": {
        "operationId": "OAuthProviderController_token",
        "parameters": [],
