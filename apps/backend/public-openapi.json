                }
              }
            },
            "description": "An error: the API error envelope; `code` says what happened"
          }
        },
        "security": [
          {
            "oauth": []
          }
        ],
        "summary": "Terminate an MCP session at the domain root (stateless: always answers ok)",
        "tags": [
          "MCP"
        ]
      },
