# ===========================================================
# Backend — Environment Variable Reference
# ===========================================================
# Copy to `.env` for local dev (or use Doppler/your secret manager).
# This file documents every variable the backend expects. Secrets are
# commented out — fill them in locally; never commit real values.
# ===========================================================


# --------------- Core ---------------
NODE_ENV=development
ENV_TYPE=development
LOG_LEVEL=DEBUG
PORT=8000

# --------------- Tenancy ---------------
# true  = multi-tenant (tenant resolution + self-registration enabled)
# false = single-tenant (one implicit tenant, registration disabled)
# Tenancy: multi (orgs + self-registration) | single (one implicit workspace)
# | personal (a workspace per user, simple signup, org UI hidden).
# TENANCY_MODE wins; MULTI_TENANT is kept for compatibility.
TENANCY_MODE=multi
MULTI_TENANT=true
IMPLICIT_TENANT_ID=1
DEFAULT_ADMIN_EMAIL=owner@example.com

# --------------- Observability ---------------
# Start the stack: `docker compose --profile observability up -d`
# Then open Grafana at http://localhost:3003 (anonymous admin).
OTEL_SERVICE_NAME=app-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Pino logs — set LOG_TRANSPORT=loki to also ship to Loki.
LOG_TRANSPORT=
LOKI_URL=http://localhost:3100

# --------------- Database (Required) ---------------
# Matches docker-compose (postgres on host port 5499).
DATABASE_URL=postgresql://postgres:postgres@localhost:5499/app?schema=public
# Shadow database for `prisma migrate dev` and `prisma migrate diff --from-migrations` (packages/appshore/db/prisma.config.ts):
# Prisma replays the migration history there, never in the dev DB. Optional; create it once with
#   docker compose exec postgres createdb -U postgres app_shadow
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5499/app_shadow?schema=public
# Connection pool tuning (pg Pool via the Prisma adapter)
# DB_POOL_MIN=5                  # minimum pool connections
# DB_POOL_MAX=20                 # maximum pool connections
# DB_CONNECTION_TIMEOUT=5000     # ms to wait for a free connection before erroring

# --------------- Redis (Required) ---------------
REDIS_URL=redis://localhost:6399/0

# --------------- API Config ---------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1
# Interactive Swagger UI at /api. On by default outside production, off in
# production; set true to turn it on there deliberately.
# SWAGGER_UI_ENABLED=false
PROJECT_NAME=App Backend
APP_URL=http://localhost:3000

# --------------- Auth Cookies ---------------
# Leave blank. The refresh cookie is host-only (no Domain attribute): it goes to
# the API host and nowhere else. A deployment that set this in an earlier
# version can keep it until old sessions expire (7 days): it is then used only
# to expire the cookies that were issued with a Domain.
COOKIE_DOMAIN=

# --------------- JWT Config ---------------
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# --- Secrets (required) ---
# Generate each with: openssl rand -hex 32
# Optional in dev (built-in dev defaults apply); REQUIRED in production —
# with NODE_ENV=production or ENV_TYPE=production the backend refuses to boot if any of these is
# unset, a public template default, or a placeholder like the values below.
# SECRET_KEY=local-dev-secret-key-minimum-32-chars-here-change-me
# JWT_ACCESS_SECRET=local-jwt-access-secret-change-in-dev-min-32-chars
# JWT_REFRESH_SECRET=local-jwt-refresh-secret-change-in-dev-min-32-chars
# Signs OAuth 2.1 access tokens. In dev it is derived from SECRET_KEY.
# OAUTH_JWT_SECRET=local-oauth-jwt-secret-change-in-dev-min-32-chars
# Signs OAuth consent challenges; never the same value as OAUTH_JWT_SECRET. In dev it is derived from SECRET_KEY.
# OAUTH_CONSENT_SECRET=local-oauth-consent-secret-change-in-dev-min-32-chars

# --------------- Authentication ---------------
BCRYPT_ROUNDS=10
# Dev-only: gates /api/v1/dev/* endpoints. Unset in prd (route 404s).
DEV_AUTH_SECRET=random-32-char-string

# --------------- Credentials Encryption ---------------
# AES-256 key for third-party credentials at rest: exactly 64 hex characters
# (openssl rand -hex 32). Optional in dev (a public dev default applies);
# REQUIRED in production. Changing it makes stored credentials unreadable.
# CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# --------------- Firebase (Required for auth) ---------------
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# --- Seed-only (read by `pnpm db:seed`, not the running app) ---
# SUPER_ADMIN_PASSWORD=            # password for the seeded super-admin login
# FIREBASE_SERVICE_ACCOUNT_KEY=    # full service-account JSON, used to create the Firebase super-admin user

# --------------- Tenant Subdomains (multi-tenant only) ---------------
TENANT_BASE_URL=localhost:3000
USE_TENANT_SUBDOMAINS=false

# --------------- Email ---------------
EMAIL_FROM=noreply@example.com
# Resend (transactional email provider, tried first)
# RESEND_API_KEY=re_your_resend_key
# SMTP fallback (Nodemailer) — used when RESEND_API_KEY is unset; all four required
# SMTP_HOST=smtp.example.com     # SMTP server hostname
# SMTP_PORT=587                  # SMTP port (465 = implicit TLS)
# SMTP_USER=smtp-user            # SMTP auth username
# SMTP_PASSWORD=                 # SMTP auth password

# --------------- S3 Object Storage ---------------
S3_BUCKET=app-files
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --------------- AI Provider ---------------
# AI_PROVIDER controls routing: 'anthropic' (direct SDK) or 'gateway' (Vercel AI Gateway)
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# AI_GATEWAY_API_KEY=your-gateway-key      # optional — needed for embeddings
# OPENAI_API_KEY=sk-your-openai-key        # optional — content moderation
# Platform AI routes (route resolver). Each is optional; a route is off until its key is set.
# OPENROUTER_API_KEY=sk-or-v1-your-key     # optional — platform language route (platform-openrouter)
# COHERE_API_KEY=your-cohere-key           # optional — platform embedding route (platform-cohere)

# --------------- LangFuse (Optional — LLM observability + prompt management) ---------------
# Without these, LangFuse tracing is disabled (zero cost).
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
PROMPT_LABEL=production

# --------------- Phone Auth (dev only) ---------------
# Any OTP matching this value passes verification in dev
TWILIO_MOCK_OTP=123456
# --- Twilio (Optional — SMS invitations + real phone OTP) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+15555550100   # sender number for outbound SMS

# --------------- QuickBooks (sample integration vendor) ---------------
# QUICKBOOKS_OAUTH_CLIENT_ID=your_client_id_here
# QUICKBOOKS_OAUTH_CLIENT_SECRET=your_client_secret_here

# --------------- OAuth Integrations (Non-secret config) ---------------
# Shared callback URL for all OAuth vendors (one endpoint handles all)
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback

# --------------- Rate limiting ---------------
# Global limit: requests per window, per signed-in user (or OAuth client + user), otherwise per client IP,
# per route. Counted in Redis, so every API replica shares one window.
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000
# Proxy hops in front of the API whose X-Forwarded-For entry is trusted. Unset: 1 in production (the load
# balancer), none elsewhere. Use 2 with a CDN in front of the load balancer. "true" is refused.
# TRUST_PROXY=1

# --------------- Outbound webhooks ---------------
# Development only: lets a webhook subscription use http and point at localhost or a
# private address, so a receiver on your machine works. Production refuses to boot with it.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# --------------- OAuth Provider (MCP Server Auth) ---------------
# Issuer: the public URL of this API. It is the `iss` of every OAuth access token and the issuer in
# /.well-known/oauth-authorization-server. Production refuses to boot unless it is a public https URL.
OAUTH_ISSUER=http://localhost:8000
# Token lifetimes in seconds (defaults shown)
# OAUTH_ACCESS_TOKEN_TTL=3600                  # access token lifetime (1 hour)
# OAUTH_REFRESH_TOKEN_TTL=2592000              # refresh token lifetime per rotation (30 days)
# OAUTH_REFRESH_TOKEN_ABSOLUTE_TTL=7776000     # absolute refresh lifetime from initial consent (90 days)

# --------------- Bull Board (Queue Admin UI) ---------------
# Dev bypass: BULL_BOARD_AUTH=false disables auth for /admin/queues
# In stg/prd leave 'true' so SUPER_ADMIN JWT is enforced
BULL_BOARD_AUTH=false

# --------------- Web Push Notifications ---------------
# Generate VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# --------------- Stripe Billing ---------------
# Price IDs live in the database (PlanConfig.providerPriceId, AddOn.providerPriceId)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --------------- Cloudflare Turnstile (Optional — bot protection on registration) ---------------
# TURNSTILE_SECRET_KEY=

# --------------- Voice Mode (Optional — LiveKit + Deepgram + Cartesia) ---------------
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3        # Deepgram speech-to-text model
# DEEPGRAM_STT_LANGUAGE=en-US      # Deepgram speech-to-text language
# CARTESIA_TTS_MODEL=sonic-3       # Cartesia text-to-speech model
# CARTESIA_TTS_LANGUAGE=en         # Cartesia text-to-speech language
# VOICE_AGENT_SECRET=   # dev default applies if unset; REQUIRED in production when LIVEKIT_URL is set
# Public origin the forked voice-agent worker calls back into
APP_API_URL=http://localhost:8000

# feature:desk:start
# --------------- Inngest (Desk durable workflows) ---------------
# Local dev: leave EVENT_KEY and SIGNING_KEY empty — the Inngest CLI dev server
# (pnpm inngest:dev) handles auth locally.
INNGEST_ENV=dev
INNGEST_SERVE_ORIGIN=http://host.docker.internal:8000
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# feature:desk:end
